# Sao chép file này thành backend/.env rồi sửa lại cho đúng máy của bạn.
# File .env đã nằm trong .gitignore, không bị đưa lên Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME_V2=eduagent_v2

# Khóa ký token đăng nhập: chuỗi ngẫu nhiên dài, mỗi máy một khóa, KHÔNG chia sẻ.
# Để trống thì start.bat tự tạo. Tạo tay: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Thư mục cài XAMPP (để start.bat tự bật MySQL). Bỏ trống thì tự dò C:\xampp, D:\xampp, D:\Program\XAMPP...
XAMPP_DIR=

# Gửi email cảnh báo (xem README mục "Gửi email"). Bỏ trống SMTP_HOST: thư lưu thành file trong backend/outbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=địa chỉ gmail,
#        SMTP_PASSWORD=Mật khẩu ứng dụng 16 ký tự (Tài khoản Google > Bảo mật > Mật khẩu ứng dụng).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
MAIL_FROM=
# Khi thử nghiệm: chuyển MỌI email tới một hộp thư của nhóm, không gửi tới người nhận thật
MAIL_REDIRECT_TO=
APP_BASE_URL=http://127.0.0.1:8000

# Ngưỡng xác suất để coi là "có nguy cơ học yếu"
RISK_THRESHOLD=0.5
